# =============================================================================
# PARSING ENGINE
# =============================================================================
def _norm(s):
    return re.sub(r"[^a-z0-9]", "", str(s).lower())


def classify_sheets(wb):
    """Group the workbook's sheets into {fy_label: {category: sheet_name}}"""
    groups = {}
    for name in wb.sheetnames:
        ws = wb[name]
        a1 = str(ws["A1"].value or "").lower()
        digits = re.findall(r"\d+", name)
        fy_key = "-".join(digits[:2]) if len(digits) >= 2 else name
        fy_label = f"FY{fy_key}"

        if "trade material" in a1:
            cat = "production"
        elif "defect" in a1 and "wise" in a1 and "month" not in a1:
            cat = "customer_defect"
        elif "defect" in a1 and "month" in a1:
            cat = "defect_month"
        else:
            cat = None
        if cat:
            groups.setdefault(fy_label, {})[cat] = name
    # keep only complete FY groups
    return {k: v for k, v in groups.items() if len(v) == 3}


def _rows(ws):
    return [list(r) for r in ws.iter_rows(values_only=True)]


STOP_WORDS = ("total", "wise", "defect", "customer", "grand", "(blank)")


def parse_production(ws):
    rows = _rows(ws)
    header = rows[1]
    total_col = trade_col = pct_col = None
    for i, h in enumerate(header):
        if h is None:
            continue
        hs = str(h).lower()
        if "production total" in hs and total_col is None:
            total_col = i
        if "customer wise trade" in hs and "%" not in hs and trade_col is None:
            trade_col = i
        if "%" in hs and pct_col is None:
            pct_col = i

    month_recs, totals = [], []
    for r in rows[2:]:
        cust = r[0]
        if cust is None:
            break
        cs = str(cust).strip()
        if cs == "" or any(k in cs.lower() for k in STOP_WORDS):
            break
        for mi in range(12):
            col = 1 + mi
            if col >= len(r):
                break
            val = r[col]
            if isinstance(val, (int, float)):
                month_recs.append({"Customer": cs, "MonthIdx": mi,
                                    "Month": MONTHS_FISCAL[mi], "Value": float(val)})
        pt = r[total_col] if total_col is not None and total_col < len(r) else None
        ct = r[trade_col] if trade_col is not None and trade_col < len(r) else None
        pc = r[pct_col] if pct_col is not None and pct_col < len(r) else None
        totals.append({
            "Customer": cs,
            "ProductionTotal": pt if isinstance(pt, (int, float)) else np.nan,
            "CustomerTrade": ct if isinstance(ct, (int, float)) else np.nan,
            "PctTrade": pc if isinstance(pc, (int, float)) else np.nan,
        })
    return pd.DataFrame(month_recs), pd.DataFrame(totals)


def parse_customer_defect(ws):
    rows = _rows(ws)
    header = rows[1]
    customers = []
    for i, h in enumerate(header[1:], start=1):
        if h is None:
            continue
        hs = str(h).strip()
        if hs.lower() in ("grand total", "total"):
            continue
        customers.append((i, hs))

    recs = []
    for r in rows[2:]:
        defect = r[0]
        if defect is None:
            continue
        ds = str(defect).strip()
        if ds == "" or ds.lower() in ("grand total", "total", "(blank)"):
            continue
        for i, cust in customers:
            if i >= len(r):
                continue
            val = r[i]
            if isinstance(val, (int, float)):
                recs.append({"Defect": ds, "Customer": cust, "Value": float(val)})
    return pd.DataFrame(recs)


def parse_defect_month(ws):
    rows = _rows(ws)
    recs = []
    for r in rows[2:]:
        defect = r[0]
        if defect is None:
            continue
        ds = str(defect).strip()
        if ds == "" or ds.lower() in ("grand total", "total", "(blank)"):
            continue
        n_months = min(12, max(0, len(r) - 2))
        for mi in range(n_months):
            col = 1 + mi
            val = r[col]
            if isinstance(val, (int, float)):
                recs.append({"Defect": ds, "MonthIdx": mi,
                             "Month": MONTHS_FISCAL[mi], "Value": float(val)})
    return pd.DataFrame(recs)


def _cust_key(name):
    """Normalized key used to match the same customer across sheets, since the
    workbook spells/cases/truncates customer names differently in different
    tables (e.g. 'KAPOOR STRIPS AND BLADES COMPA' vs '...COMPANY')."""
    return re.sub(r"[^A-Z0-9]", "", str(name).upper())[:20]


def unify_customer_names(*dfs):
    """Pick one canonical (longest, then title-cased-preferred) display name
    per normalized key, and rewrite the 'Customer' column consistently
    across every dataframe passed in."""
    all_names = pd.concat([d["Customer"] for d in dfs if "Customer" in d.columns], ignore_index=True)
    key_df = pd.DataFrame({"Customer": all_names})
    key_df["key"] = key_df["Customer"].map(_cust_key)
    key_df["len"] = key_df["Customer"].str.len()
    canonical = (key_df.sort_values("len", ascending=False)
                 .drop_duplicates("key")
                 .set_index("key")["Customer"].to_dict())
    for d in dfs:
        if "Customer" in d.columns:
            d["Customer"] = d["Customer"].map(lambda c: canonical.get(_cust_key(c), c))
    return dfs


@st.cache_data(show_spinner="Reading & parsing workbook ...")
def load_all(file_bytes):
    wb = openpyxl.load_workbook(io.BytesIO(file_bytes), data_only=True)
    groups = classify_sheets(wb)
    if not groups:
        return None

    month_frames, totals_frames, cd_frames, dm_frames = [], [], [], []
    for fy_label, sheets in groups.items():
        m_df, t_df = parse_production(wb[sheets["production"]])
        m_df["FY"] = fy_label
        t_df["FY"] = fy_label
        month_frames.append(m_df)
        totals_frames.append(t_df)

        cd_df = parse_customer_defect(wb[sheets["customer_defect"]])
        cd_df["FY"] = fy_label
        cd_frames.append(cd_df)

        dm_df = parse_defect_month(wb[sheets["defect_month"]])
        dm_df["FY"] = fy_label
        dm_frames.append(dm_df)

    df_month = pd.concat(month_frames, ignore_index=True)
    df_totals = pd.concat(totals_frames, ignore_index=True)
    df_cd = pd.concat(cd_frames, ignore_index=True)
    df_dm = pd.concat(dm_frames, ignore_index=True)

    # Unify customer spelling/casing/truncation across the three sheet types
    # so filters, Pareto rankings and YoY comparisons all match correctly.
    df_month, df_totals, df_cd = unify_customer_names(df_month, df_totals, df_cd)

    fy_order = sorted(groups.keys(), key=lambda x: re.findall(r"\d+", x))
    for d in (df_month, df_totals, df_cd, df_dm):
        d["FY"] = pd.Categorical(d["FY"], categories=fy_order, ordered=True)

    return {"month": df_month, "totals": df_totals, "cd": df_cd,
            "dm": df_dm, "fy_order": fy_order}


