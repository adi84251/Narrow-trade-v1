def pareto_chart(df, cat_col, val_col, title, top_n=15):
    g = df.groupby(cat_col, as_index=False)[val_col].sum().sort_values(val_col, ascending=False)
    g = g.head(top_n).reset_index(drop=True)
    g["Cumulative %"] = g[val_col].cumsum() / g[val_col].sum() * 100

    fig = go.Figure()
    fig.add_bar(x=g[cat_col], y=g[val_col], name="Diversion (T)",
                marker_color=PRIMARY, yaxis="y1")
    fig.add_trace(go.Scatter(x=g[cat_col], y=g["Cumulative %"], name="Cumulative %",
                              mode="lines+markers", marker_color=ACCENT, yaxis="y2"))
    fig.add_hline(y=80, line_dash="dot", line_color="red", yref="y2",
                  annotation_text="80% line", annotation_position="top left")
    fig.update_layout(
        title=title, template="plotly_white", height=460,
        yaxis=dict(title="Diversion (Tons)"),
        yaxis2=dict(title="Cumulative %", overlaying="y", side="right", range=[0, 110]),
        legend=dict(orientation="h", yanchor="bottom", y=1.02, x=0),
        margin=dict(t=60, b=110),
    )
    fig.update_xaxes(tickangle=-40)
    return fig, g


def histogram_chart(values, title, color=PRIMARY):
    fig = px.histogram(values, nbins=30, template="plotly_white",
                        color_discrete_sequence=[color], marginal="box")
    fig.update_layout(title=title, xaxis_title="Diversion Quantity (T)",
                       yaxis_title="Frequency", showlegend=False, height=420)
    return fig


def control_chart(series_df, x_col, y_col, title):
    d = series_df.sort_values(x_col).reset_index(drop=True)
    x = d[y_col].values
    xbar = np.mean(x)
    if len(x) > 1:
        mr = np.abs(np.diff(x))
        mrbar = np.mean(mr)
    else:
        mrbar = 0
    ucl = xbar + 2.66 * mrbar
    lcl = max(xbar - 2.66 * mrbar, 0)

    fig = go.Figure()
    fig.add_trace(go.Scatter(x=d[x_col].astype(str), y=d[y_col], mode="lines+markers",
                              name="Diversion", line=dict(color=PRIMARY, width=2.5)))
    fig.add_hline(y=xbar, line_color=ACCENT2, line_dash="dash", annotation_text="Mean")
    fig.add_hline(y=ucl, line_color="red", line_dash="dot", annotation_text="UCL")
    fig.add_hline(y=lcl, line_color="red", line_dash="dot", annotation_text="LCL")
    out_of_control = d[(d[y_col] > ucl) | (d[y_col] < lcl)]
    if len(out_of_control):
        fig.add_trace(go.Scatter(x=out_of_control[x_col].astype(str), y=out_of_control[y_col],
                                  mode="markers", marker=dict(color="red", size=11, symbol="x"),
                                  name="Out of control"))
    fig.update_layout(title=title, template="plotly_white", height=430,
                       xaxis_title="Period", yaxis_title="Diversion (T)")
    return fig


def heatmap_chart(df, row_col, col_col, val_col, title, col_order=None):
    piv = df.pivot_table(index=row_col, columns=col_col, values=val_col, aggfunc="sum", fill_value=0)
    if col_order:
        piv = piv.reindex(columns=[c for c in col_order if c in piv.columns])
    piv = piv.loc[piv.sum(axis=1).sort_values(ascending=False).index]
    fig = px.imshow(piv, aspect="auto", color_continuous_scale="Blues",
                     labels=dict(color="Tons"))
    fig.update_layout(title=title, template="plotly_white", height=max(420, 22 * len(piv)))
    return fig


